# Copiá este archivo como .env.local y completá los valores. Nunca subas .env.local al repositorio.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: no lleva prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa a la base, solo para correr migraciones (npm run db:migrar)
# Supabase > Connect > Session pooler, reemplazando [YOUR-PASSWORD] por la contraseña de la base
SUPABASE_DB_URL=

# Dirección pública del sistema (para los enlaces de ingreso por mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Padrón de CapitalIA (solo servidor)
PADRON_API_TOKEN=

# Clave que usa Vercel Cron para sincronizar el padrón todos los días
CRON_SECRET=

# Migue, el asistente (solo servidor). Sin clave, Migue responde solo las preguntas rápidas.
# En OpenRouter conviene desactivar el registro de mensajes y el entrenamiento con los datos.
OPENROUTER_API_KEY=
# Modelo de OpenRouter; vacío usa anthropic/claude-opus-5.5. Más barato: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# Ingreso con CiDiTuc por Ciudad Digital (solo servidor). Sin estas variables, se entra con mail y contraseña.
# La app se da de alta en el repo ditec-desarrollo/cidituc (src/routes/PrivateRoute.jsx) con la misma clave
# y con la vuelta <dominio>/auth/cidituc/callback.
CIDITUC_LOGIN_URL=https://ciudaddigital.smt.gob.ar
CIDITUC_BACKEND_URL=https://estadisticas.smt.gob.ar:5000
CIDITUC_NEXT_KEY=evaluacion-desempeno
# 32 caracteres o más al azar: firma la cookie del primer ingreso
CIDITUC_SESSION_SECRET=
# Opcional: certificados que le falten a la cadena TLS del backend municipal (PEM). Nunca se apaga la verificación.
CIDITUC_CA_PEM=
